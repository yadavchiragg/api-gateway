# ─────────────────────────────────────────────────────────
#  Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env to Git — add it to .gitignore
# ─────────────────────────────────────────────────────────

# Redis connection string
# Local Docker:   redis://localhost:6379
# Render Redis:   rediss://red-xxxx:6379  (note: rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# Rate limiting configuration
RATE_LIMIT_MAX=5       # Max requests allowed
RATE_LIMIT_WINDOW=10   # Time window in seconds
